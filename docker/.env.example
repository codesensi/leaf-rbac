# leaf-rbac 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env

# 运行环境，可选 dev、prod
SPRING_PROFILES_ACTIVE=prod

# 数据库类型，可选 h2、mysql、postgresql
DB_TYPE=h2

# 数据库运行模式，可选 managed、external
# managed：随项目启动自动部署数据库；external：使用已有的数据库
DB_MODE=managed

# redis 运行模式，同数据库运行模式
REDIS_MODE=managed

# redis 连接信息
REDIS_HOST=<ip>
REDIS_PORT=<port>
REDIS_PASSWORD=<替换为真实密码>

# mysql 连接信息，仅当 DB_TYPE=mysql 时填写
MYSQL_URL=<ip:port>
MYSQL_USERNAME=<替换为真实用户>
MYSQL_PASSWORD=<替换为真实密码>

# postgresql 连接信息，仅当 DB_TYPE=postgresql 时填写
POSTGRESQL_URL=<ip:port>
POSTGRESQL_USERNAME=<替换为真实用户>
POSTGRESQL_PASSWORD=<替换为真实密码>