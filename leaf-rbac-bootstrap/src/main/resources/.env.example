# ============================================================
# leaf-rbac 环境变量模板 —— 复制为 .env 后按需填写
#
# 用法：将本文件复制成同目录下的 `.env`（.env 已被 .gitignore 忽略，不会入库），
#       在里面填写连接信息。application.yml 通过
#       `spring.config.import: optional:file:.env[.properties]` 自动加载，
#       与 yml 中 `${MYSQL_HOST:默认值}` 占位符联动，覆盖对应默认值。
#
# 安全提示：.env 内为明文，请勿提交；每个环境（dev/prod）各自维护。
# ============================================================

# ===== 数据库 =====

# ---- Redis ----
REDIS_DATABASE=1
REDIS_HOST=192.168.2.3
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ---- MySQL ----
MYSQL_HOST=192.168.2.3
MYSQL_PORT=3306
MYSQL_DATABASE=leaf_rbac_dev
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# ---- PostgreSQL ----
POSTGRESQL_HOST=192.168.2.3
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=leaf_rbac_dev
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=your_postgres_password
