# ============================================================
# leaf-rbac Docker 部署环境变量模板（唯一配置源）
# 用法：复制为同目录 .env（勿提交仓库），按需填写。
#       在项目根执行 docker compose -f docker/docker-compose.yml --env-file docker/.env。
# 说明：
#   - 本文件同时供 ① docker compose 插值(如 ${APP_PORT}) ② 注入容器环境变量。
#   - Spring 在应用内读取这些环境变量(DB_TYPE/MYSQL_*/POSTGRESQL_*/REDIS_*)，
#     无需再维护配置文件同级的 .env（Docker 部署下 Spring 不读文件，全走环境变量）。
# 连接方式：宿主机 IP + 端口直连。
#   前提：Redis/MySQL/PostgreSQL 已跑在 Docker 里，且已把端口映射到宿主机
#         （docker ps 的 PORTS 列能看到如 0.0.0.0:3306->3306/tcp、0.0.0.0:6379->6379/tcp）。
#   这里 HOST 填宿主机 IP（如 192.168.1.10），不是容器服务名。
#   若中间件与应用同机、且用非 bridge 网络模式，可填 127.0.0.1；否则填局域网/外网可达 IP。
# ============================================================

# ---- 运行 profile（prod 更贴合生产，dev 便于调试）----
SPRING_PROFILES_ACTIVE=prod

# ---- 应用主端口（宿主机映射端口；容器内部固定 9098，勿改）----
APP_PORT=9098

# ---- 应用镜像标签（镜像名固定 codesensi/leaf-rbac）----
APP_IMAGE_TAG=latest

# ---- Java 堆参数 ----
JAVA_OPTS=-Xms256m -Xmx512m

# ---- 数据库类型：mysql / postgresql ----
DB_TYPE=mysql

# ---- MySQL（DB_TYPE=mysql 时生效，端口需已映射到宿主机）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=leaf_rbac
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password

# ---- PostgreSQL（DB_TYPE=postgresql 时生效）----
# POSTGRESQL_HOST=127.0.0.1
# POSTGRESQL_PORT=5432
# POSTGRESQL_DATABASE=leaf_rbac
# POSTGRESQL_USERNAME=postgres
# POSTGRESQL_PASSWORD=your_password

# ---- Redis（端口需已映射到宿主机）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=your_password
