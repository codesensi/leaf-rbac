<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.codesensi.leaf</groupId>
    <artifactId>leaf-rbac</artifactId>
    <version>${revision}</version>
    <name>leaf-rbac</name>
    <description>一叶管理后台</description>
    <packaging>pom</packaging>

    <modules>
        <module>leaf-rbac-common</module>
        <module>leaf-rbac-framework</module>
        <module>leaf-rbac-system</module>
        <module>leaf-rbac-api</module>
        <module>leaf-rbac-bootstrap</module>
        <module>leaf-rbac-codegen</module>
    </modules>

    <properties>
        <revision>1.0.0</revision>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 依赖版本 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <lombok.version>1.18.46</lombok.version>
        <hutool-all.version>5.8.46</hutool-all.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <springdoc.version>2.8.17</springdoc.version>
        <h2.version>2.4.240</h2.version>
        <mysql.version>9.7.0</mysql.version>
        <postgresql.version>42.7.11</postgresql.version>
        <mybatis-flex.version>1.11.7</mybatis-flex.version>
        <sa-token.version>1.45.0</sa-token.version>
        <mica-xss.version>4.1.0</mica-xss.version>
        <ip2region.version>3.3.7</ip2region.version>
        <UserAgentUtils.version>1.21</UserAgentUtils.version>
        <easy-captcha.version>1.6.2</easy-captcha.version>
        <nashorn-core.version>15.7</nashorn-core.version>
        <!-- 插件版本 -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    </properties>

    <!-- 依赖版本管理（子模块继承） -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>cn.codesensi.leaf</groupId>
                <artifactId>leaf-rbac-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.codesensi.leaf</groupId>
                <artifactId>leaf-rbac-framework</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.codesensi.leaf</groupId>
                <artifactId>leaf-rbac-system</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.codesensi.leaf</groupId>
                <artifactId>leaf-rbac-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.codesensi.leaf</groupId>
                <artifactId>leaf-rbac-bootstrap</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.codesensi.leaf</groupId>
                <artifactId>leaf-rbac-codegen</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-dependencies -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- https://mvnrepository.com/artifact/cn.hutool/hutool-all -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool-all.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-lang3 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.springdoc/springdoc-openapi-starter-webmvc-ui -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.mybatis-flex/mybatis-flex-spring-boot3-starter -->
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.mybatis-flex/mybatis-flex-codegen -->
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-codegen</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.h2database/h2 -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.mysql/mysql-connector-j -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.postgresql/postgresql -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/cn.dev33/sa-token-spring-boot3-starter -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/cn.dev33/sa-token-jwt -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-jwt</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.lionsoul/ip2region -->
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/eu.bitwalker/UserAgentUtils -->
            <dependency>
                <groupId>eu.bitwalker</groupId>
                <artifactId>UserAgentUtils</artifactId>
                <version>${UserAgentUtils.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/com.github.whvcse/easy-captcha -->
            <dependency>
                <groupId>com.github.whvcse</groupId>
                <artifactId>easy-captcha</artifactId>
                <version>${easy-captcha.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.openjdk.nashorn/nashorn-core -->
            <dependency>
                <groupId>org.openjdk.nashorn</groupId>
                <artifactId>nashorn-core</artifactId>
                <version>${nashorn-core.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 公共依赖（所有子模块默认继承） -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 配置编译行为 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!-- 配置编译时的注解处理器 -->
                    <annotationProcessorPaths>
                        <!-- mybatis-flex APT （必须在 lombok 之前）-->
                        <path>
                            <groupId>com.mybatis-flex</groupId>
                            <artifactId>mybatis-flex-processor</artifactId>
                            <version>${mybatis-flex.version}</version>
                        </path>
                        <!-- lombok 生成 getter、setter、toString 等代码 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- 处理 @ConfigurationProperties 注解，生成配置元数据文件（spring-configuration-metadata.json），以支持 IDE 的配置提示。 -->
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- 配置编译器参数 -->
                    <!-- 向 Java 编译器传递额外的参数，保留方法参数的名称信息（用于反射时获取参数名称），如果没有 -parameters，反射时只能获取到 arg0、arg1 这样的参数名。 -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 配置跳过单元测试 -->
            <!-- 当运行 mvn test 或 mvn install 时，不会执行任何单元测试。测试代码仍然会被编译，但不会运行。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <!-- 成一个扁平化的 pom.xml 文件，移除动态内容，使其更适合发布到 Maven 仓库或与其他工具集成。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <!-- 生成扁平化的 pom.xml 文件并覆盖原始文件 -->
                    <updatePomFile>true</updatePomFile>
                    <!-- 仅解析对 CI（持续集成）友好的部分，保留一些动态内容（如 ${project.version}），但移除其他不必要的动态内容。 -->
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <!-- 在 process-resources 阶段执行 flatten 目标，生成扁平化的 pom.xml。 -->
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <!-- 在 clean 阶段执行 clean 目标，清理生成的扁平化 pom.xml。 -->
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
